# Backend S3 Configuration
# Copy this file to backend.hcl and fill with your values
# DO NOT commit backend.hcl to version control

bucket       = "your-terraform-state-bucket"
key          = "cert-study-app/prod/terraform.tfstate"
region       = "us-east-1"
profile      = "your-aws-profile"

# Native S3 state locking (conditional-write lock object). No DynamoDB
# lock table is required. If an interrupted apply leaves a lock behind,
# release it with: terraform force-unlock <lock-id>
use_lockfile = true
